# Session signing (set in production / Docker)
SESSION_SECRET=change-me-to-a-long-random-string

# API
PORT=3001
HOST=127.0.0.1
NODE_ENV=development

# SQLite database file (created automatically)
DATA_DIR=./data
DATABASE_PATH=./data/hub.db

# License (maintenance contract)
LICENSE_EXPIRES=2027-12-31T23:59:59.000Z

# Frontend (Vite) — leave empty to use dev proxy
VITE_API_URL=

# AI defaults for licensed deployments (no OpenRouter / free tier)
VITE_AI_DEFAULT_MODEL=gemini-2.5-flash
VITE_AI_PROVIDER=google
